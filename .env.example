TELEGRAM_BOT_TOKEN=
# Required. Comma-separated numeric chat IDs allowed to control this bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional. Commands run from this directory by default.
TELEBOT_ROOT_DIR=.

# Optional. Keep command output bounded.
TELEBOT_COMMAND_TIMEOUT_MS=60000
TELEBOT_MAX_OUTPUT_CHARS=3500

# AI provider routing. claude uses local Claude CLI. openai/gemini use APIs.
AI_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_EFFORT=medium
CLAUDE_CONTINUE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Used by /call to control CallingBot over HTTP.
CALLINGBOT_BASE_URL=http://localhost:3000
